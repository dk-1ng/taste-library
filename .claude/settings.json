{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "opus",
  "effortLevel": "high",
  "attribution": {
    "commit": "Assisted-by: Claude Code",
    "pr": ""
  },
  "permissions": {
    "deny": [
      "Bash(git push * main)",
      "Bash(git push *:main)",
      "Bash(git push *:main *)",
      "Bash(git push *refs/heads/main*)",
      "Bash(git push *--force*)",
      "Bash(git push -f*)",
      "Bash(git push * -f*)",
      "Bash(git push * +*)",
      "Bash(git push *--mirror*)",
      "Bash(git push *--no-verify*)",
      "Bash(git push *--delete*)",
      "Bash(git push * :*)",
      "Bash(gh repo delete *)",
      "Bash(gh pr merge * --admin*)"
    ],
    "ask": [
      "Bash(gh pr merge *)",
      "Bash(gh repo edit *)",
      "Bash(gh release *)",
      "Bash(npm publish *)",
      "Bash(pnpm publish *)",
      "Bash(git branch -D *)",
      "Bash(gh issue delete *)",
      "Bash(gh label delete *)"
    ]
  }
}
