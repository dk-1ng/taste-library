# Dependencies and build output
node_modules/
dist/
build/
*.tsbuildinfo

# Tests
coverage/
playwright-report/
test-results/

# Library index and cache (rebuilt locally, never committed)
.tastelib/

# Environment and logs
.env
.env.*
!.env.example
*.log
npm-debug.log*
pnpm-debug.log*

# Editors and operating systems
.DS_Store
Thumbs.db
desktop.ini
*.swp
.idea/
.vscode/*
!.vscode/extensions.json

# Claude Code: per-user settings stay local; project settings are versioned
.claude/settings.local.json

# Python bytecode (embeds local paths)
__pycache__/
*.py[cod]
