{
  "name": "taste-library",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=26.13.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "clean": "tsc -b --clean",
    "lint": "biome lint --error-on-warnings .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "typecheck": "tsc -b",
    "test": "pnpm -r --if-present test",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm build",
    "prepare": "node scripts/setup-hooks.mjs",
    "test:e2e": "pnpm --filter @tastelib/e2e e2e",
    "test:e2e:install": "pnpm --filter @tastelib/e2e e2e:install"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
